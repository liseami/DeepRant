{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window event, clipboard, links and signed updater permissions; model and settings stay in Rust",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "updater:default",
    "process:allow-restart"
  ]
}
